# ========================================================
# CivicTrust AI — Environment Configuration Example
# Copy this file to .env.local for local overrides.
# DO NOT COMMIT REAL SECRETS OR SERVICE ROLE KEYS TO GIT!
# ========================================================

# Application Mode: demo | supabase
VITE_STORAGE_MODE=demo

# Supabase (Optional Production Adapter)
# Use your project anon/public key only. NEVER expose SUPABASE_SERVICE_ROLE_KEY in frontend!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-placeholder-anon-key

# Optional Map Provider (Defaults to OpenStreetMap / Leaflet without keys)
VITE_MAP_PROVIDER=osm
VITE_MAPBOX_TOKEN=pk.placeholder_token_optional

# Optional AI Verification Service (Gemini / OCR)
# When unset or offline, CivicTrust AI gracefully falls back to local heuristic & simulation mode.
VITE_AI_VERIFICATION_PROVIDER=local_heuristic
VITE_GEMINI_API_KEY=AIzaSyPlaceholderKeyForGeminiVisionIfConfigured

# Application Settings
VITE_DEFAULT_LANGUAGE=en
VITE_SLA_CHECK_INTERVAL_SECONDS=30
VITE_MAX_UPLOAD_SIZE_MB=5
